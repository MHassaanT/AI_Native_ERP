# Application Configuration
APP_NAME=AI-Native ERP
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_secret_in_production

# PostgreSQL / Supabase Core Database
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=erp_secure_password_123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_erp
DATABASE_URL=postgresql+asyncpg://erp_admin:erp_secure_password_123@localhost:5432/ai_erp
SYNC_DATABASE_URL=postgresql://erp_admin:erp_secure_password_123@localhost:5432/ai_erp

# Multi-Tenancy
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
MULTI_TENANCY_ENABLED=True

# Redis Configuration (Distributed locks & caching)
REDIS_URL=redis://localhost:6379/0

# Redpanda / Kafka Event Streaming Configuration (Uncomment if broker is active)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=erp-backend
# KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Deterministic Ledger Engine Configuration
LEDGER_TIER1_CEILING=2500.0000
LEDGER_TIER2_CEILING=25000.0000
BASE_CURRENCY=USD
CURRENCY_PRECISION=4

# OpenTelemetry / Observability
OTEL_SERVICE_NAME=ai-native-erp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_ENABLED=False
