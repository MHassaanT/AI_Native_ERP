# Application Configuration
APP_NAME=AI-Native ERP
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
ENABLE_OUTBOX_DISPATCHER=False
OUTBOX_DISPATCHER_POLL_SECONDS=2

# Choose openrouter or gemini and configure its matching API key.
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Baileys WhatsApp Support Service
WHATSAPP_SERVICE_URL=http://localhost:8100
WHATSAPP_INTERNAL_TOKEN=replace_with_a_long_random_shared_token
WHATSAPP_ENCRYPTION_KEY=replace_with_64_hex_characters_generated_for_this_environment

# PostgreSQL / Supabase Core Database
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=replace_with_a_unique_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_erp
DATABASE_URL=postgresql+asyncpg://erp_admin:replace_with_a_unique_local_password@localhost:5432/ai_erp
SYNC_DATABASE_URL=postgresql://erp_admin:replace_with_a_unique_local_password@localhost:5432/ai_erp

# Multi-Tenancy
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
MULTI_TENANCY_ENABLED=True

# Redis Configuration (Distributed locks & caching)
REDIS_URL=redis://localhost:6379/0

# Redpanda / Kafka Event Streaming Configuration (Uncomment if broker is active)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=erp-backend
# KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Deterministic Ledger Engine Configuration
LEDGER_TIER1_CEILING=2500.0000
LEDGER_TIER2_CEILING=25000.0000
BASE_CURRENCY=USD
CURRENCY_PRECISION=4

# OpenTelemetry / Observability
OTEL_SERVICE_NAME=ai-native-erp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_ENABLED=False
